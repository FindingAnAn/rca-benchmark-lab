{
  "analysis": {
    "window_seconds": 60,
    "min_reference_points": 20,
    "min_coverage_ratio": 0.8,
    "random_seed": 42,
    "methods": [
      "mad",
      "nsigma",
      "iqr",
      "pca",
      "isolation_forest"
    ],
    "max_rows": 500000,
    "pca_components": 5,
    "forest_trees": 32,
    "forest_samples": 256,
    "eda_max_visual_entities": 5,
    "eda_max_visual_features": 16,
    "eda_max_correlation_features": 128
  },
  "metric": {
    "enabled": false,
    "step_seconds": 10,
    "chunk_seconds": 900,
    "max_export_seconds": 3600,
    "max_rows": 500000,
    "entity_label": "pod_id",
    "systems": [
      {
        "system_id": "system_1",
        "match_labels": {
          "vnf_instance_name": "REPLACE_SYSTEM_1"
        }
      },
      {
        "system_id": "system_2",
        "match_labels": {
          "vnf_instance_name": "REPLACE_SYSTEM_2"
        }
      },
      {
        "system_id": "system_3",
        "match_labels": {
          "vnf_instance_name": "REPLACE_SYSTEM_3"
        }
      },
      {
        "system_id": "system_4",
        "match_labels": {
          "vnf_instance_name": "REPLACE_SYSTEM_4"
        }
      },
      {
        "system_id": "system_5",
        "match_labels": {
          "vnf_instance_name": "REPLACE_SYSTEM_5"
        }
      }
    ],
    "metrics": [
      {
        "name": "request_counter",
        "kind": "counter",
        "unit": "request",
        "comparison_dimensions": [
          "command_name",
          "pod_type"
        ]
      },
      {
        "name": "response_counter",
        "kind": "counter",
        "unit": "response",
        "comparison_dimensions": [
          "command_name",
          "pod_type"
        ]
      },
      {
        "name": "process_time_ms",
        "kind": "gauge",
        "unit": "ms",
        "comparison_dimensions": [
          "command_name",
          "pod_type"
        ]
      }
    ]
  },
  "request_response_rules": [],
  "log": {
    "enabled": false,
    "error_pattern": "error|exception|timeout|failed",
    "sources": [
      {
        "file": "hht_fixed_whitelease_to290926.csv",
        "system_id": "hht_fixed_whitelease",
        "timestamp_column": "@timestamp",
        "text_column": "message",
        "time_unit": "kibana_display",
        "timezone": "Asia/Ho_Chi_Minh",
        "cdr_service_id": "7000003"
      },
      {
        "file": "hht_fixed_officewan_to290926.csv",
        "system_id": "hht_fixed_officewan",
        "timestamp_column": "@timestamp",
        "text_column": "message",
        "time_unit": "kibana_display",
        "timezone": "Asia/Ho_Chi_Minh",
        "cdr_service_id": "7000004"
      },
      {
        "file": "hht_fixed_llmonthlyfee_to290926.csv",
        "system_id": "hht_fixed_llmonthlyfee",
        "timestamp_column": "@timestamp",
        "text_column": "message",
        "time_unit": "kibana_display",
        "timezone": "Asia/Ho_Chi_Minh",
        "cdr_service_id": "7000001"
      },
      {
        "file": "hht_fixed_iptvrecurringbyocs_to290926.csv",
        "system_id": "hht_fixed_iptvrecurringbyocs",
        "timestamp_column": "@timestamp",
        "text_column": "message",
        "time_unit": "kibana_display",
        "timezone": "Asia/Ho_Chi_Minh",
        "cdr_service_id": "7000006"
      },
      {
        "file": "hht_fixed_cablemonthly_to290926.csv",
        "system_id": "hht_fixed_cablemonthly",
        "timestamp_column": "@timestamp",
        "text_column": "message",
        "time_unit": "kibana_display",
        "timezone": "Asia/Ho_Chi_Minh",
        "cdr_service_id": "7000005"
      }
    ],
    "parser_config": "config/log_parser.json"
  },
  "trace": {
    "enabled": false
  },
  "alarm": {
    "enabled": false
  },
  "relationships": {
    "enabled": true,
    "fields": [
      "request_counter_rate",
      "response_counter_rate",
      "process_time_ms",
      "log_error_ratio",
      "log_count"
    ],
    "min_pairs": 20,
    "min_reference_points": 20,
    "max_lag_windows": 3,
    "max_visual_cohorts": 10,
    "rules": [
      {
        "name": "request_response_gap",
        "left": "request_counter_rate",
        "right": "response_counter_rate",
        "operation": "relative_gap",
        "threshold_mode": "reference_quantile",
        "quantile": 0.99,
        "direction": "upper",
        "min_left": 0.01,
        "consecutive_windows": 3
      },
      {
        "name": "process_time_high",
        "left": "process_time_ms",
        "operation": "value",
        "threshold_mode": "reference_quantile",
        "quantile": 0.99,
        "consecutive_windows": 3
      },
      {
        "name": "log_error_ratio_high",
        "left": "log_error_ratio",
        "operation": "value",
        "threshold_mode": "reference_quantile",
        "quantile": 0.99,
        "consecutive_windows": 3
      }
    ]
  },
  "feature_calculation": {
    "enabled": true,
    "spec_path": "config/feature_mapping.json"
  }
}
